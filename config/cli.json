{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "./opencode-zh-bundle/plugins/opencode-quota-zh",
    {
      "package": "./opencode-zh-bundle/plugins/opencode-enhanced-sidebar-zh",
      "options": {
        "sessionOverview": true,
        "subagents": true,
        "subagentsSortOrder": "desc",
        "subagentsMaxEntries": 10,
        "subagentsTtlDays": 3,
        "skillPanel": true,
        "skillPanelMaxUsed": 8,
        "skillPanelDefaultOpen": true
      }
    }
  ]
}
