{
  "name": "opencode-zh-bundle",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal local distribution bundle for Chinese OpenCode quota, sidebar, Matt Workshop, and GPT reset-card plugins.",
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@opencode/plugin": "2.0.11",
    "@opentelemetry/api": "1.9.1",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "comment-json": "5.0.0",
    "jsonc-parser": "3.3.1",
    "solid-js": "1.9.12",
    "xdg-basedir": "5.1.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build:matt-workshop": "tsc --project plugins/opencode-matt-workshop/tsconfig.json",
    "sync:matt-skills": "node scripts/sync-matt-skills.mjs",
    "build:quota-zh": "node plugins/opencode-quota-zh/scripts/build-dev.mjs",
    "build:quota-zh:runtime": "node plugins/opencode-quota-zh/scripts/build-runtime.mjs",
    "typecheck:quota-zh": "tsc --project plugins/opencode-quota-zh/tsconfig.json --noEmit",
    "stage:runtime": "node scripts/stage-runtime.mjs"
  }
}
