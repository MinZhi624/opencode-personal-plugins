{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*",
    "tui.ts",
    "../opencode-quota-zh/src/bun-sqlite.d.ts",
    "../opencode-quota-zh/src/better-sqlite3.d.ts",
    "../opencode-quota-zh/src/node-sqlite.d.ts"
  ]
}
